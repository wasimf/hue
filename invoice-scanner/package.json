{
  "name": "invoice-scanner",
  "version": "1.0.0",
  "private": true,
  "description": "Batch invoice scanning and field extraction service (Node.js + TypeScript + PaddleOCR)",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "ocr:service": "python3 -m uvicorn app:app --app-dir ocr-service --host 0.0.0.0 --port 8868"
  },
  "dependencies": {
    "@fastify/multipart": "^9.0.1",
    "@fastify/static": "^8.0.3",
    "csv-stringify": "^6.5.0",
    "fastify": "^5.1.0",
    "file-type": "^19.6.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.7.76",
    "pino": "^9.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "pino-pretty": "^11.3.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
