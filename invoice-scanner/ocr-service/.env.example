# Languages loaded by default (comma separated PaddleOCR codes).
# Examples: en | ch | latin | arabic | he (see README for Hebrew caveats)
PADDLE_LANGS=en
PADDLE_USE_GPU=false
PADDLE_USE_ANGLE_CLS=true

# Detector tuning for dense invoice tables. Lower thresholds detect thin rows,
# a larger unclip ratio keeps digits from being clipped.
PADDLE_DET_DB_THRESH=0.3
PADDLE_DET_DB_BOX_THRESH=0.5
PADDLE_DET_DB_UNCLIP_RATIO=1.8
PADDLE_DET_LIMIT_SIDE_LEN=1920
PADDLE_DROP_SCORE=0.35

# Load the models at startup rather than on the first request, so the container
# only reports healthy once it can actually serve. docker compose sets this.
PADDLE_PRELOAD=false

# Safety cap on rasterisation DPI requested by the Node app.
PADDLE_MAX_DPI=400
LOG_LEVEL=INFO
