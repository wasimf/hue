# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
# Pretty-printed logs for local development (requires pino-pretty)
LOG_PRETTY=true

# ---------------------------------------------------------------------------
# Uploads
# ---------------------------------------------------------------------------
# Directory for temporary uploads. Files are removed after processing unless
# KEEP_UPLOADS=true.
UPLOAD_DIR=./tmp/uploads
KEEP_UPLOADS=false
# Per-file size limit in bytes (default 20 MB)
MAX_FILE_SIZE_BYTES=20971520
# Maximum number of files accepted in a single batch
MAX_FILES_PER_BATCH=25
# Maximum number of pages processed per document (guards against huge PDFs)
MAX_PAGES_PER_DOCUMENT=25

# ---------------------------------------------------------------------------
# OCR
# ---------------------------------------------------------------------------
# paddle | mock  -- "mock" replays fixtures from tests/fixtures/mock-ocr and is
# intended for tests, CI and offline development.
OCR_PROVIDER=paddle
# Base URL of the PaddleOCR sidecar (see ocr-service/README section in README.md)
OCR_SERVICE_URL=http://127.0.0.1:8868
OCR_TIMEOUT_MS=120000
OCR_MAX_RETRIES=2
# Comma-separated PaddleOCR language codes. The first one is the primary model.
# Common values: en, ch, latin, arabic, he (Hebrew support varies by model, see README)
OCR_LANGS=en
# Rasterisation DPI used by the sidecar when converting PDF pages to images
OCR_PDF_DPI=200
# Drop recognised text lines below this confidence before parsing (0..1)
OCR_MIN_LINE_CONFIDENCE=0.45
# Concurrent OCR requests in flight (per process)
OCR_CONCURRENCY=2
# Fixture directory used when OCR_PROVIDER=mock
MOCK_OCR_DIR=./tests/fixtures/mock-ocr

# ---------------------------------------------------------------------------
# PDF text layer
# ---------------------------------------------------------------------------
# When true, digital-born PDFs are read via their embedded text layer and OCR is
# skipped for those pages. Scanned PDFs automatically fall back to OCR.
PDF_TEXT_LAYER_ENABLED=true
# Minimum characters found on a page for the text layer to be considered usable
PDF_TEXT_LAYER_MIN_CHARS=80

# ---------------------------------------------------------------------------
# Parsing / validation
# ---------------------------------------------------------------------------
# DMY (31/12/2025, European + Israeli) or MDY (12/31/2025, US)
DATE_ORDER=DMY
# Absolute tolerance (currency units) when checking sum + vat == total
AMOUNT_TOLERANCE_ABS=0.05
# Relative tolerance (fraction of the total) for the same check. Keep this
# small: it is meant to absorb rounding, not genuine discrepancies.
AMOUNT_TOLERANCE_REL=0.001
# Expected VAT rates (percent, comma separated). Used to sanity-check and to
# derive missing amounts. Israel is 18 (17 before 2025), EU examples: 19, 20, 21.
EXPECTED_VAT_RATES=18,17,20,19,21,23,25
# Below this per-field score the value is discarded and a warning is emitted
FIELD_MIN_SCORE=0.35
# Documents scoring below this are flagged as "not an invoice"
INVOICE_MIN_DOCUMENT_SCORE=0.3
# Mean OCR confidence below this flags the document as low quality
LOW_QUALITY_CONFIDENCE=0.55

# ---------------------------------------------------------------------------
# Batches
# ---------------------------------------------------------------------------
# In-memory batch retention. Swap InMemoryBatchRepository for a DB-backed
# implementation to persist results (see README "Extending").
BATCH_TTL_MS=3600000
MAX_BATCHES_IN_MEMORY=100
